# ---------------------------------------------------------------------------
# Copy to .env.local and fill in with values from the Neon Console.
# .env.local is git-ignored. NEVER commit real values.
# ---------------------------------------------------------------------------

# === REQUIRED =============================================================
# The only two variables this application reads at runtime.
# Both are public: they are endpoints, not credentials. Holding them grants
# nothing, because Row Level Security gates every row (see db/schema.sql).

# Neon Console -> your project -> Auth -> Configuration
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-example-123456.neonauth.c-2.us-east-2.aws.neon.tech/neondb/auth

# Neon Console -> your project -> Data API
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-example-123456.apirest.c-2.us-east-2.aws.neon.tech/neondb/rest/v1


# === SETUP ONLY ===========================================================
# Server-only secret. Used once, by you, to apply db/schema.sql:
#     psql "$DATABASE_URL" -f db/schema.sql
# Not needed at all if you paste db/schema.sql into the Neon SQL Editor.
#
# No request-time code reads this, and that is deliberate: connecting as the
# database owner would bypass every RLS policy and make them decorative.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require


# === NOT USED BY THIS IMPLEMENTATION ======================================
# Listed because the assignment brief names them, and kept here so the choice
# is visible rather than silent. This build does not read either one:
#
#   NEON_AUTH_BASE_URL      - would be the server-side copy of the Auth URL
#                             above. Unused: authentication happens in the
#                             browser via @neondatabase/neon-js, and the route
#                             handlers only forward the caller's JWT.
#
#   NEON_AUTH_COOKIE_SECRET - would sign session cookies. Unused: Neon Managed
#                             Better Auth owns the session; this app never
#                             mints or signs one of its own.
#
# If you later add server-side session handling, uncomment these, set them in
# Vercel as server-only (no NEXT_PUBLIC_ prefix), and update this comment.
#
# NEON_AUTH_BASE_URL=https://ep-example-123456.neonauth.c-2.us-east-2.aws.neon.tech/neondb/auth
# NEON_AUTH_COOKIE_SECRET=replace-with-a-long-random-string-openssl-rand-base64-32
